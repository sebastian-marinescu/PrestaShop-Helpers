# ------------------------------------------------------------------------------
# Staging Sync Script Configuration Template
# Copy this file to '.env' in the same folder and configure your local settings.
# ------------------------------------------------------------------------------

# Sync Mode: 'local' (if production is on the same server) or 'remote' (not implemented/needed for this setup)
SYNC_MODE=local

# Absolute directory paths of environments
# Note: The script will automatically resolve symlinks if any of these are symlinks.
PROD_DIR=/home/www/production
STAGING_DIR=/home/www/staging

# Domains/URLs (without protocol prefix, e.g. 'domain.ch')
PROD_DOMAIN=domain.com
STAGING_DOMAIN=staging.domain.com

# Staging-Only WIP Preservation
# If true, the script automatically compares staging/modules and production/modules.
# Any directories unique to Staging (e.g. 'usm_configurator') will be preserved.
AUTO_PRESERVE_STAGING_ONLY_MODULES=true

# Manual path preservation (space-separated relative paths to keep, e.g. "modules/some_custom_module")
PRESERVE_PATHS=""

# Image Sync
# If false, the script will skip syncing '/img/' physically (recommended, as the script
# will automatically configure Apache rules on Staging to fall back to Production images).
# Set to true if you want a complete physical rsync of the '/img/' folder.
SYNC_IMAGES=false

# Database Sync Optimization
# If true, skips importing heavy log and statistics table data (ps_log, ps_connections, ps_guest, etc.)
# while keeping their empty table structures. This speeds up DB sync by up to 90%.
EXCLUDE_HEAVY_DB_DATA=true

# Developer Email Override
# If set, overrides the main shop email address (PS_SHOP_EMAIL) in the Staging database
# so that test emails and system notifications are sent to the developer instead of the client.
DEVELOPER_EMAIL=dev@domain.com

# Modules to disable on Staging (space-separated list)
# Useful for disabling cloud connection, tracking, or payment modules on Staging (e.g. ps_accounts, ps_metrics).
DISABLE_MODULES_ON_STAGING="ps_accounts"


# ------------------------------------------------------------------------------
# PrestaShop Upgrade Toolkit (ps-upgrade.sh) – see ps-upgrade.md
# Everything below is OPTIONAL: all values are auto-detected if left empty.
# PROD_DIR / STAGING_DIR (above) are used to detect the environment.
# ------------------------------------------------------------------------------

# Base folder for backups, release cache, logs & reports (OUTSIDE the docroot!).
# The toolkit only works inside "<BACKUP_DIR>/ps-upgrade/". Default: <parent of shop root>/backups
BACKUP_DIR=/home/www/backups

# Number of backup sets to keep per environment (only toolkit sets are rotated)
BACKUP_KEEP=5

# Additional paths (relative to the shop root, space-separated) to exclude from backups
BACKUP_EXCLUDE_PATHS=""

# Extra IPs that keep access during maintenance (comma-separated, e.g. your browser IPv6).
# Your SSH client IP and the server's own IP are added automatically.
MAINTENANCE_IPS=""

# Basic-Auth credentials for the smoke tests on password protected environments (user:password)
SMOKE_HTTP_AUTH=""

# PHP CLI binary used for the upgrade. Empty = auto-detect the binary matching the WEB PHP version.
PHP_BIN=""

# Fallback if helper/env-check.php cannot be reached: PHP version of the web server (e.g. 8.2)
WEB_PHP_VERSION=""

# Token for helper/env-check.php (generated automatically on first use)
ENV_CHECK_TOKEN=""

# Overrides for auto-detection (normally not needed)
# PS_ENV=staging              # staging | production
# ADMIN_DIR=admin123abc        # admin folder name
# THEME_NAME=mychildtheme      # active theme
# THEME_PARENT=warehouse       # parent theme
# THEME_MODULES="iqit* ph_*"   # modules shipped with the theme (list or globs)
# THEME_MIN_VERSION_FOR_PS9=4.8.0   # minimum parent theme version per PrestaShop major
# STAGING_DB_MUST_CONTAIN=staging   # extra fail-safe for the staging database name

# Files that are restored if the upgrade changes them (space-separated)
# UPGRADE_PRESERVE_FILES=".htaccess robots.txt img/.htaccess"

# Files ignored when comparing Production with the tested Staging branch
# GIT_COMPARE_EXCLUDE="app/config/parameters.php .htaccess img/.htaccess robots.txt"

# Branch prefix for upgrade branches on Staging
# UPGRADE_BRANCH_PREFIX="upgrade/ps-"

# PHP memory limit for the Update Assistant CLI
# PHP_MEMORY_LIMIT=2048M

# Release API (official PrestaShop distribution API, also used by the Update Assistant)
# RELEASES_API_URL=https://api.prestashop-project.org
